#!/bin/sh
set -eu

# Melos script `exec` launches a bare `melos` child. Keep that child on the
# workspace-pinned dependency too, without requiring a global installation.
MANYTYPE_TOOL_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PATH="$MANYTYPE_TOOL_DIR:$PATH"
export PATH
exec dart run melos "$@"
