# Private canary only. Production mode is deliberately rejected by the binary.
deployment_mode = "private_canary"
network_id = "manytype-private-canary"
quic_listen = "0.0.0.0:33020"
health_listen = "127.0.0.1:33021"
data_dir = "DATA_DIR"

# Same-phrase devices currently derive the same transport peer identity. Each
# admitted connection must match one complete principal pair exactly.
[[allowed_principals]]
peer_id = "ACCOUNT_DEVICE_PEER_ID"
account_identity = "ACCOUNT_IDENTITY_HEX"

[limits]
max_connections = 32
max_streams_per_connection = 16
connection_setup_timeout_seconds = 15
stream_setup_timeout_seconds = 10
stream_io_timeout_seconds = 30
max_frame_bytes = 2097152
max_message_bytes = 8388608
max_blob_bytes = 4194304
max_space_storage_bytes = 536870912
max_account_storage_bytes = 1073741824
max_total_storage_bytes = 2147483648
max_sync_state_bytes = 536870912
max_file_index_bytes = 268435456
